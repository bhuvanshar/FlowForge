{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowforge.local/schemas/node-config.v1.json",
  "title": "FlowForge node configuration schemas, version 1",
  "$comment": "One definition per node type under $defs, keyed by the node type identifier (see node-types.v1.json). To validate a node's `configuration`, validate it against $defs/<type>. Rules JSON Schema cannot express (must also be implemented by the backend validator): variable names unique within a node; transform output fields unique within a node; header names unique case-insensitively. Mirrors frontend/src/features/editor/config (tested by node-config contract tests with shared fixtures).",
  "$defs": {
    "safeString": {
      "$comment": "Text that may contain {{ path.to.value }} references. Inside {{ }} only a dotted/indexed property path is allowed: no calls, operators, quotes or code. Stray single braces are literal text.",
      "type": "string",
      "maxLength": 2000,
      "pattern": "^[^{]*(?:(?:\\{(?!\\{)|\\{\\{\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*|\\[[0-9]+\\])*\\s*\\}\\})[^{]*)*$"
    },
    "promptText": {
      "$comment": "Prompt template: the same {{ }} reference rules as safeString, up to 20000 characters.",
      "type": "string",
      "maxLength": 20000,
      "pattern": "^[^{]*(?:(?:\\{(?!\\{)|\\{\\{\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*|\\[[0-9]+\\])*\\s*\\}\\})[^{]*)*$"
    },
    "safeJson": {
      "$comment": "Any JSON value whose strings are safeStrings.",
      "anyOf": [
        {
          "$ref": "#/$defs/safeString"
        },
        {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/safeJson"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/safeJson"
          }
        }
      ]
    },
    "variableName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "headerName": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
    },
    "credentialId": {
      "type": "string",
      "description": "Id of a stored credential (lower-case UUID). The secret itself never appears in workflow JSON.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "core.manualTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "testInput": {
          "type": [
            "object",
            "array"
          ],
          "description": "Sample input used when testing the workflow manually."
        }
      }
    },
    "core.setVariables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variables"
      ],
      "properties": {
        "variables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/variableName"
              },
              "value": {
                "$ref": "#/$defs/safeString"
              }
            }
          }
        }
      }
    },
    "core.condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "operator"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/safeString",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "equals",
            "notEquals",
            "greaterThan",
            "greaterThanOrEqual",
            "lessThan",
            "lessThanOrEqual",
            "contains",
            "notContains",
            "startsWith",
            "endsWith",
            "isEmpty",
            "isNotEmpty"
          ]
        },
        "value": {
          "$ref": "#/$defs/safeString"
        }
      },
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "isEmpty",
              "isNotEmpty"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "value"
          ]
        }
      },
      "else": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "$ref": "#/$defs/safeString",
            "minLength": 1
          }
        }
      }
    },
    "core.transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "source",
              "operation"
            ],
            "properties": {
              "field": {
                "$ref": "#/$defs/variableName"
              },
              "source": {
                "$ref": "#/$defs/safeString",
                "minLength": 1
              },
              "operation": {
                "enum": [
                  "copy",
                  "toUpperCase",
                  "toLowerCase",
                  "trim",
                  "toNumber",
                  "toString",
                  "parseJson",
                  "stringifyJson",
                  "length"
                ]
              }
            }
          }
        }
      }
    },
    "core.logger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "$ref": "#/$defs/safeString",
          "minLength": 1
        }
      }
    },
    "core.httpRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "url",
        "headers",
        "query",
        "timeoutSeconds"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD"
          ]
        },
        "url": {
          "allOf": [
            {
              "$ref": "#/$defs/safeString"
            },
            {
              "pattern": "^(https?://|\\{\\{).+$"
            }
          ]
        },
        "headers": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/headerName"
              },
              "value": {
                "$ref": "#/$defs/safeString"
              }
            }
          }
        },
        "query": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "value": {
                "$ref": "#/$defs/safeString"
              }
            }
          }
        },
        "body": {
          "$ref": "#/$defs/safeJson"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "credentialId": {
          "$ref": "#/$defs/credentialId"
        }
      },
      "if": {
        "properties": {
          "method": {
            "enum": [
              "GET",
              "HEAD"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "body"
          ]
        }
      }
    },
    "cronExpression": {
      "$comment": "5 fields (minute hour day-of-month month day-of-week) or 6 fields (second first). Field ranges are checked by the backend (Spring CronExpression) and the editor.",
      "type": "string",
      "maxLength": 120,
      "pattern": "^[0-9A-Za-z*?/,#-]+(\\s+[0-9A-Za-z*?/,#-]+){4,5}$"
    },
    "timeZone": {
      "$comment": "IANA time zone id (e.g. Europe/Berlin) or UTC; existence is checked by the backend and the editor.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_+/-]{0,63}$"
    },
    "triggerTestInput": {
      "type": [
        "object",
        "array"
      ],
      "description": "Sample input used for manual runs."
    },
    "core.webhookTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "authentication",
        "inputMode"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "authentication": {
          "enum": [
            "signature",
            "token",
            "none"
          ],
          "$comment": "none is rejected unless the server allows unauthenticated webhooks"
        },
        "inputMode": {
          "enum": [
            "body",
            "request"
          ]
        },
        "testInput": {
          "$ref": "#/$defs/triggerTestInput"
        }
      }
    },
    "core.scheduleTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cron",
        "timezone",
        "missedRunPolicy"
      ],
      "properties": {
        "cron": {
          "$ref": "#/$defs/cronExpression"
        },
        "timezone": {
          "$ref": "#/$defs/timeZone"
        },
        "missedRunPolicy": {
          "enum": [
            "skip",
            "runOnce"
          ]
        },
        "testInput": {
          "$ref": "#/$defs/triggerTestInput"
        }
      }
    },
    "aiBaseUrl": {
      "type": "string",
      "description": "Base URL of an OpenAI-compatible API (the request goes to <baseUrl>/chat/completions). No expressions, query or fragment.",
      "maxLength": 300,
      "pattern": "^https?://[^\\s{}?#]+$"
    },
    "aiModelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "responseSchema": {
      "type": "object",
      "description": "JSON Schema (restricted keyword subset, see WORKFLOW_SCHEMA.md) the model's JSON reply must satisfy."
    },
    "core.aiModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "baseUrl",
        "model",
        "userPrompt",
        "responseFormat",
        "timeoutSeconds",
        "maxRetries"
      ],
      "properties": {
        "provider": {
          "enum": [
            "openaiCompatible"
          ]
        },
        "baseUrl": {
          "$ref": "#/$defs/aiBaseUrl"
        },
        "model": {
          "$ref": "#/$defs/aiModelName"
        },
        "credentialId": {
          "$ref": "#/$defs/credentialId"
        },
        "systemPrompt": {
          "$ref": "#/$defs/promptText"
        },
        "userPrompt": {
          "allOf": [
            {
              "$ref": "#/$defs/promptText"
            },
            {
              "minLength": 1
            }
          ]
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "responseFormat": {
          "enum": [
            "text",
            "json"
          ]
        },
        "jsonMode": {
          "enum": [
            "jsonObject",
            "prompt"
          ]
        },
        "responseSchema": {
          "$ref": "#/$defs/responseSchema"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "if": {
        "properties": {
          "responseFormat": {
            "const": "json"
          }
        },
        "required": [
          "responseFormat"
        ]
      },
      "then": {
        "required": [
          "jsonMode"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "jsonMode"
              ]
            },
            {
              "required": [
                "responseSchema"
              ]
            }
          ]
        }
      }
    }
  }
}
