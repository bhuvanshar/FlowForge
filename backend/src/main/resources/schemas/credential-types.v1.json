{
  "schemaVersion": 1,
  "description": "Credential types. Canonical catalog shared by backend (CredentialTypeRegistry) and frontend (credentials page). Secret fields are stored encrypted and never returned by the API.",
  "secretField": {
    "minLength": 8,
    "maxLength": 4096,
    "pattern": "^[^\\r\\n]+$"
  },
  "credentialTypes": [
    {
      "type": "httpBearer",
      "label": "Bearer token",
      "description": "Sent as Authorization: Bearer <token>",
      "usableBy": [
        "core.httpRequest",
        "core.aiModel"
      ],
      "fields": [
        {
          "name": "token",
          "label": "Token",
          "secret": true
        }
      ]
    },
    {
      "type": "httpBasic",
      "label": "Basic authentication",
      "description": "Sent as Authorization: Basic base64(username:password)",
      "usableBy": [
        "core.httpRequest",
        "core.aiModel"
      ],
      "fields": [
        {
          "name": "username",
          "label": "Username",
          "secret": false,
          "maxLength": 200,
          "pattern": "^[^:\\r\\n]+$"
        },
        {
          "name": "password",
          "label": "Password",
          "secret": true
        }
      ]
    },
    {
      "type": "httpHeader",
      "label": "API key header",
      "description": "Sent as <header name>: <value>, e.g. X-API-Key",
      "usableBy": [
        "core.httpRequest",
        "core.aiModel"
      ],
      "fields": [
        {
          "name": "headerName",
          "label": "Header name",
          "secret": false,
          "maxLength": 100,
          "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
        },
        {
          "name": "value",
          "label": "Value",
          "secret": true
        }
      ]
    }
  ]
}
