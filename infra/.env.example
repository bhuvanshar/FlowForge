# Copy to infra/.env (cp infra/.env.example infra/.env) and adjust. Never commit infra/.env.

POSTGRES_DB=flowforge
POSTGRES_USER=flowforge
# Change this. Used by PostgreSQL and the backend container.
POSTGRES_PASSWORD=change-me

# Host ports, bound to 127.0.0.1 only.
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Spring profile for the backend container (dev | prod)
SPRING_PROFILES_ACTIVE=prod

# HTTP Request node. Comma-separated hosts the node may call ("api.example.com", "*.example.com").
# Empty = outbound HTTP disabled.
# The AI Model node uses the same list: add your provider's host, e.g. FLOWFORGE_HTTP_ALLOWED_HOSTS=api.openai.com
FLOWFORGE_HTTP_ALLOWED_HOSTS=
# Keep false in real use: blocks loopback/private/link-local (cloud metadata) addresses even for allowed hosts.
FLOWFORGE_HTTP_ALLOW_PRIVATE_ADDRESSES=false

# Webhook triggers (Module 11). Webhooks must use an HMAC signature or a token; set to true only to allow
# authentication "none". The webhook URL is http://localhost:${FRONTEND_PORT}/api/v1/hooks/<id> (localhost only).
FLOWFORGE_WEBHOOKS_ALLOW_UNAUTHENTICATED=false
# Schedule triggers: keep true for exactly one backend instance per database (no distributed scheduling).
FLOWFORGE_SCHEDULER_ENABLED=true

# Credential encryption (Module 12). Required to store credentials. Generate a key and keep it ONLY here (infra/.env is
# git-ignored) or in a secret store; losing it makes stored credentials unreadable:
#   echo "FLOWFORGE_CREDENTIALS_KEYS=k1:$(openssl rand -base64 32)" >> infra/.env
# Key rotation: append ",k2:<new key>" (the last key is active, or set FLOWFORGE_CREDENTIALS_ACTIVE_KEY_ID), restart,
# POST /api/v1/credentials/re-encrypt, then remove the old key.
FLOWFORGE_CREDENTIALS_KEYS=
FLOWFORGE_CREDENTIALS_ACTIVE_KEY_ID=
# Host names the server answers to. Add a tunnel's public name only if you deliberately expose webhooks.
FLOWFORGE_ALLOWED_HOST_NAMES=localhost,127.0.0.1,[::1]
